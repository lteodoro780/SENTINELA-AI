# SENTINELA-AI environment example
# Copie este arquivo para deploy/.env e ajuste conforme seu ambiente.
# Nunca publique o arquivo .env real.

OPEN_WEBUI_PORT=3000
OLLAMA_PORT=11434

# Gere uma chave forte:
# openssl rand -hex 32
WEBUI_SECRET_KEY=troque_esta_chave_por_uma_chave_forte

ENABLE_RAG_HYBRID_SEARCH=true

# Exemplos futuros para integrações
GLPI_URL=https://glpi.example.local/apirest.php
GLPI_APP_TOKEN=troque_este_valor
GLPI_USER_TOKEN=troque_este_valor

ZABBIX_URL=https://zabbix.example.local/api_jsonrpc.php
ZABBIX_API_TOKEN=troque_este_valor
